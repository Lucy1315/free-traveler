{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,js,jsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,js,cjs,mjs,json}\" \".github/**/*.{yml,yaml}\"",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test tests/e2e/publicSmoke.spec.ts tests/e2e/travelTools.spec.ts",
    "task:contract": "python3 scripts/audit_tasks.py",
    "screen:contract": "python3 scripts/check_screen_contract.py",
    "validate": "python3 scripts/validate_inputs.py && npm run task:contract && python3 scripts/build_waves.py && npm run screen:contract",
    "ci": "npm run lint && npm run typecheck && npm run test:unit && npm run task:contract && npm run screen:contract -- --mode=ci && npm run build",
    "release:check": "npm run ci && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
